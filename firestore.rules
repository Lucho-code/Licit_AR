rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSimulation(data) {
      return data.keys().hasAll(['id', 'name', 'userId', 'inputs']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.userId == request.auth.uid &&
        data.inputs is map;
    }

    match /simulations/{simulationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(simulationId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
        isValidId(simulationId) && 
        isValidSimulation(incoming());
        
      allow update: if isSignedIn() && 
        isValidId(simulationId) &&
        isValidSimulation(incoming()) && 
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
        
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(simulationId);
    }

    function isValidOffersState(data) {
      return data.keys().hasAll(['userId', 'items', 'offers']) &&
        data.userId == request.auth.uid &&
        data.items is list &&
        data.offers is list;
    }

    match /offers/{userId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(userId) && userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid && userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
        isValidId(userId) && userId == request.auth.uid &&
        isValidOffersState(incoming());
        
      allow update: if isSignedIn() && 
        isValidId(userId) && userId == request.auth.uid &&
        isValidOffersState(incoming()) && 
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
        
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(userId) && userId == request.auth.uid;
    }
  }
}
